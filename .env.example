# =====================================================================
# GSO E-Ticketing Backend — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# Generate secrets: php -r "echo bin2hex(random_bytes(32));"
# =====================================================================

CI_ENVIRONMENT = production

# --- APP ---
# Local dev:  app.baseURL = 'http://localhost:8080/'
# Production: app.baseURL = 'https://backend.hywb.online/'
app.baseURL = 'http://localhost:8080/'

# --- JWT ---
# REQUIRED: long random string (min 32 bytes hex). Must match across deploys
# or all issued tokens invalidate.
JWT_SECRET =
JWT_EXPIRES_IN = 3600
JWT_REFRESH_IN = 604800

# --- FRONTEND ORIGIN (JWT audience + CORS allowlist) ---
# Local dev:  APP_FRONTEND_URL = http://localhost:5173/
# Production: APP_FRONTEND_URL = https://gso.hywb.online
APP_FRONTEND_URL = http://localhost:5173/

# --- PRODUCTION HARDENING (enable on the bsu.edu.ph subdomain deploy) ---
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true

# --- DATABASE (MySQLi) ---
database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
# database.default.port = 3306

# --- ENCRYPTION (REQUIRED: 32-byte hex for AES-256-GCM file security) ---
encryption.key =
